{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kristal:github-private-read-surface:1.0",
  "$comment": "Private-only, limited derived reader. Not portable-AI and NOT acceptable for PUBLIC C1/C2/C3 intake.",
  "title": "Kristal Private Limited Read Surface",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "kit_version",
    "slug",
    "target_root",
    "entrypoint",
    "state_ref",
    "state_logical_commitment",
    "ready",
    "errors",
    "surface_digest",
    "file_count",
    "total_bytes",
    "files",
    "materialization_object_count",
    "materialization_objects",
    "note"
  ],
  "properties": {
    "format": {
      "const": "kristal.github-private-read-surface/1.0"
    },
    "kit_version": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "target_root": {
      "type": "string",
      "pattern": "^kristals/[a-z0-9][a-z0-9._-]*$"
    },
    "entrypoint": {
      "const": "README.md"
    },
    "state_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "state_logical_commitment": {
      "type": [
        "object",
        "null"
      ]
    },
    "ready": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "surface_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "file_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "media_type",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "materialization_object_count": {
      "const": 0
    },
    "materialization_objects": {
      "const": []
    },
    "note": {
      "type": "string"
    }
  }
}
